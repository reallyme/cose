{
  "schema": 1,
  "lanes": {
    "policy": {
      "workflow": "release-readiness.yml"
    },
    "code": {
      "workflow": "rust-ci.yml"
    },
    "proto": {
      "workflow": "protobuf-ci.yml"
    },
    "fuzz": {
      "workflow": "fuzz.yml",
      "paths": [
        "crates/",
        "fuzz/",
        "vectors/"
      ]
    }
  },
  "release": {
    "tagPrefix": "reallyme-cose-v",
    "crates": {
      "preflight": "crates-package-preflight.yml",
      "publish": "crates-release.yml",
      "artifacts": [
        "reallyme-cose-crates-{version}-{sha}"
      ],
      "tagJob": "finalize"
    }
  }
}
